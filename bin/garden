#!/usr/bin/env ruby
# frozen_string_literal: true

# 🌸 garden: a cute little suite of local dev tools.
# usage: garden [--port 4747] [--root ~/src] [--no-open]

require "optparse"
require_relative "../lib/garden"

options = {
  port: 4747,
  root: File.join(Dir.home, "src"),
  open: true,
  jira_site: ENV.fetch("JIRA_SITE", "https://1password.atlassian.net"),
  config_dir: File.join(ENV.fetch("XDG_CONFIG_HOME", File.join(Dir.home, ".config")), "garden")
}

OptionParser.new do |opts|
  opts.banner = "usage: garden [options]"
  opts.on("--port N", Integer, "port to bloom on (default 4747)") { |port| options[:port] = port }
  opts.on("--root DIR", "folder of repos for the branches page (default ~/src)") { |dir| options[:root] = File.expand_path(dir) }
  opts.on("--jira-site URL", "jira cloud site (default $JIRA_SITE or 1password.atlassian.net)") { |url| options[:jira_site] = url }
  opts.on("--config-dir DIR", "where settings.json lives (default ~/.config/garden)") { |dir| options[:config_dir] = File.expand_path(dir) }
  opts.on("--[no-]open", "open the browser (default yes)") { |open| options[:open] = open }
end.parse!

settings = Garden::Settings::Store.new(File.join(options[:config_dir], "settings.json"))
finder = Garden::Branches::RepoFinder.new(options[:root])
local_repos = Garden::Github::LocalRepos.new(finder)
# Branches and worktrees are two pages over the same repos, so they share one API (and its snapshot cache).
branches_api = Garden::Branches::Api.new(root: options[:root], settings:, local_repos:)
tools = [
  Garden::Tool.new(slug: "home", emoji: "🌻", api: Garden::Home::Api.new, shares: ["tasks"]),
  Garden::Tool.new(slug: "prs", emoji: "💌", api: Garden::Prs::Api.new(repos: local_repos, settings:)),
  Garden::Tool.new(slug: "reviews", emoji: "👀", api: Garden::Reviews::Api.new(hidden_slugs: -> { settings.hidden_slugs })),
  Garden::Tool.new(slug: "tasks", emoji: "📝", api: Garden::Tasks::Api.new(todoist: Garden::Todoist::Client.from_env)),
  Garden::Tool.new(slug: "branches", emoji: "🌿", api: branches_api),
  Garden::Tool.new(slug: "worktrees", emoji: "🏡", api: branches_api, shares: ["branches"]),
  Garden::Tool.new(slug: "jira", emoji: "🎟️", api: Garden::Jira::Api.new(site: options[:jira_site])),
  Garden::Tool.new(slug: "settings", emoji: "⚙️", api: Garden::Settings::Api.new(store: settings))
]

$stdout.sync = true
url = "http://localhost:#{options[:port]}"
app = Garden::App.new(port: options[:port], tools:, settings:)

trap("INT") do
  puts "\n🌙 garden closed, sweet dreams 💕"
  exit
end

begin
  Garden::HttpServer.new(app, options[:port]).start do
    puts "🌸 garden is blooming at #{url}  (ctrl-c to close)"
    system("open", url) if options[:open]
  end
rescue Errno::EADDRINUSE
  abort "🥺 port #{options[:port]} is already taken. is the garden already open? try --port 4748"
end
