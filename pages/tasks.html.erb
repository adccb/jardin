    <header class="hero">
      <h1><span class="bob" aria-hidden="true">🧺</span> <span class="title"><%= t('tasks.title') %></span> <span class="bob" aria-hidden="true">🍓</span></h1>
      <p class="tagline" id="task-summary"><%= t('tasks.tagline') %></p>
      <div class="controls">
        <button id="new-task" class="btn btn-primary" type="button" aria-keyshortcuts="c"><%= t('tasks.new_task') %> <kbd>c</kbd></button>
      </div>
    </header>

    <div class="pr-layout">
      <aside class="repo-panel" aria-labelledby="repo-panel-title">
        <details id="repo-details" open>
          <summary>
            <h2 id="repo-panel-title"><span aria-hidden="true">🗂️</span> <%= t('tasks.panel.heading') %> <small id="repo-count"></small></h2>
          </summary>
          <p class="repo-panel-actions">
            <button type="button" class="link-btn" id="repos-all"><%= t('tasks.panel.select_all') %></button> ·
            <button type="button" class="link-btn" id="repos-none"><%= t('tasks.panel.clear') %></button>
          </p>
          <div id="repo-list"></div>
        </details>
      </aside>

      <div class="pr-main">
    <section class="task-garden" aria-labelledby="todoist-title">
      <section id="todoist-section" class="todoist-section" aria-labelledby="todoist-title">
        <h2 id="todoist-title" class="list-heading">
          <span aria-hidden="true">🌷</span> <span id="todoist-heading"><%= t('tasks.todoist.heading') %></span> <span class="count" id="todoist-count"></span>
          <a class="link-btn todoist-open" id="todoist-open" href="https://app.todoist.com/app/today" target="_blank" rel="noopener"><%= t('tasks.todoist.open_today') %></a>
        </h2>
        <div class="tabs todoist-tabs" role="tablist" id="todoist-tabs" aria-label="<%= t('tasks.todoist.tabs_label') %>" hidden></div>
        <p id="todoist-status" class="todoist-status" hidden></p>
        <ul id="todoist-list" class="task-list" role="tabpanel" aria-labelledby="todoist-title"></ul>
      </section>
    </section>

    <p class="key-hints" aria-hidden="true">
      <span><kbd>c</kbd> <%= t('tasks.hints.new') %></span>
      <span><kbd>↑</kbd><kbd>↓</kbd> <%= t('tasks.hints.move') %></span>
      <span><kbd>x</kbd> <%= t('tasks.hints.done') %></span>
      <span><kbd>⌫</kbd> <%= t('tasks.hints.delete') %></span>
      <span><kbd>u</kbd> <%= t('tasks.hints.undo') %></span>
      <span><kbd>?</kbd> <%= t('tasks.hints.help') %></span>
    </p>
      </div>
    </div>

    <dialog id="task-dialog" class="task-dialog" aria-labelledby="task-dialog-title">
      <form method="dialog" id="task-form">
        <h2 id="task-dialog-title"><%= t('tasks.dialog.title') %></h2>
        <label class="sr-only" for="task-input"><%= t('tasks.dialog.label') %></label>
        <input id="task-input" type="text" maxlength="500" autocomplete="off" placeholder="<%= t('tasks.dialog.placeholder') %>">
        <p class="task-dialog-hint"><%= t('tasks.dialog.hint_html') %></p>
        <div class="dialog-actions">
          <button class="btn" value="cancel" formnovalidate><%= t('common.never_mind') %></button>
          <button class="btn btn-primary" value="create"><%= t('tasks.dialog.create') %></button>
        </div>
      </form>
    </dialog>
