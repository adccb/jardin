    <header class="hero">
      <h1><span class="bob" aria-hidden="true">🧺</span> <span class="title"><%= t('tasks.title') %></span> <span class="bob" aria-hidden="true">🍓</span></h1>
      <p class="tagline" id="task-summary"><%= t('tasks.tagline') %></p>
      <div class="controls">
        <button id="refresh" class="btn" type="button"><%= t('common.refresh') %></button>
        <span id="freshness" class="freshness" aria-live="polite"></span>
      </div>
    </header>

    <div class="pr-layout">
      <aside class="repo-panel" aria-labelledby="repo-panel-title">
        <details id="repo-details" open>
          <summary>
            <h2 id="repo-panel-title"><span aria-hidden="true">🗂️</span> <%= t('tasks.panel.heading') %> <small id="repo-count"><span class="bone"></span></small></h2>
          </summary>
          <p class="repo-panel-actions">
            <button type="button" class="link-btn" id="repos-all"><%= t('tasks.panel.select_all') %></button> ·
            <button type="button" class="link-btn" id="repos-none"><%= t('tasks.panel.clear') %></button>
          </p>
          <div id="repo-list" data-shape="tasks-panel" data-shape-groups=".repo-list, .repo-empty" data-shape-items="li"><%= skeleton_groups(shape('tasks-panel', [2, 2])) %></div>
        </details>
      </aside>

      <section class="pr-main task-garden" aria-label="<%= t('tasks.todoist.tabs_label') %>">
        <div id="stats" class="stats" data-shape="tasks-stats" data-shape-items=".stat"><%= skeleton('stat', shape('tasks-stats', [2]).first) %></div>
        <div class="tabs" role="tablist" id="todoist-tabs" aria-label="<%= t('tasks.todoist.tabs_label') %>"><%= skeleton('tab', 2) %></div>
        <div class="panel" id="todoist-panel" role="tabpanel">
          <div class="toolbar">
            <p class="shown" id="tasks-shown"></p>
            <div class="toolbar-row">
              <input id="tasks-search" type="search" placeholder="<%= t('tasks.search_placeholder') %>" aria-label="<%= t('tasks.search_label') %>">
              <button id="new-task" class="btn btn-small btn-primary" type="button" aria-keyshortcuts="c"><%= t('tasks.new_task') %> <kbd>c</kbd></button>
              <a class="btn btn-small" id="todoist-open" href="https://app.todoist.com/app/today" target="_blank" rel="noopener"><%= t('tasks.todoist.open_today') %></a>
            </div>
            <div id="tasks-chips" class="chips" role="group" aria-label="<%= t('tasks.chips_label') %>"><%= skeleton('chip', 3) %></div>
          </div>
          <div id="todoist-status" hidden></div>
          <ul id="todoist-list" class="task-list" data-shape="tasks-list" data-shape-items=".task-row"><%= skeleton_items(shape('tasks-list', [4]).first, 'task-row', list: true) %><li class="sr-only"><%= t('tasks.todoist.loading') %></li></ul>
        </div>
      </section>
    </div>

    <dialog id="task-dialog" class="task-dialog" aria-labelledby="task-dialog-title">
      <form method="dialog" id="task-form">
        <h2 id="task-dialog-title"><%= t('tasks.dialog.title') %></h2>
        <label class="sr-only" for="task-input"><%= t('tasks.dialog.label') %></label>
        <input id="task-input" type="text" maxlength="500" autocomplete="off" placeholder="<%= t('tasks.dialog.placeholder') %>">
        <p class="task-dialog-hint"><%= t('tasks.dialog.hint_html') %></p>
        <div class="dialog-actions">
          <button class="btn" value="cancel" formnovalidate><%= t('common.never_mind') %></button>
          <button class="btn btn-primary" value="create"><%= t('tasks.dialog.create') %></button>
        </div>
      </form>
    </dialog>
