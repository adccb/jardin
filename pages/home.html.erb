    <header class="hero">
      <h1><span class="bob" aria-hidden="true">🌻</span> <span class="title" id="greeting"><%= t("home.greeting.#{greeting_part}") %></span> <span class="bob" aria-hidden="true">🌸</span></h1>
      <p class="tagline" id="home-summary"><%= t('home.tagline') %></p>
      <div class="controls">
        <button id="refresh" class="btn" type="button"><%= t('common.refresh') %></button>
        <span id="freshness" class="freshness" aria-live="polite"></span>
      </div>
    </header>

<%# One tab per garden that isn't hidden on the settings page; home.js fills each from that garden's own API. -%>
<% sections = [%w[prs 💖], %w[reviews 👀], %w[tasks 📝], %w[jira 🎟️]].select { |slug, _| tools.any? { _1.slug == slug } && !hidden_pages.include?(slug) } -%>
<% if sections.empty? -%>
    <div class="empty"><span class="big" aria-hidden="true">🙈</span><%= t('home.no_cards') %></div>
<% else -%>
    <section class="home" aria-label="<%= t('home.tabs_label') %>">
      <div id="stats" class="stats">
<% sections.each do |slug, emoji| -%>
        <div class="stat"><b><span class="bone"></span></b><span><span aria-hidden="true"><%= emoji %></span> <%= t("home.stats.#{slug}", count: 2) %></span></div>
<% end -%>
      </div>
      <div class="tabs" role="tablist" id="home-tabs" aria-label="<%= t('home.tabs_label') %>">
<% sections.each do |slug, emoji| -%>
        <button type="button" class="tab" role="tab" id="home-tab-<%= slug %>" data-tab="<%= slug %>" aria-controls="home-panel"
                aria-selected="false" tabindex="-1">
          <span aria-hidden="true"><%= emoji %></span> <%= t("home.cards.#{slug}.heading") %> <span class="tab-count" data-count></span>
        </button>
<% end -%>
      </div>
      <div class="panel" id="home-panel" role="tabpanel" aria-busy="true">
        <div class="toolbar">
          <p class="shown" id="home-shown"></p>
          <div class="toolbar-row">
            <input id="home-search" type="search" placeholder="<%= t('home.search_placeholder') %>" aria-label="<%= t('home.search_label') %>">
          </div>
          <div id="home-chips" class="chips" role="group" aria-label="<%= t('home.chips_label') %>"><%= skeleton('chip', 3) %></div>
        </div>
        <div id="home-note"></div>
        <ul class="home-list" id="home-list" data-shape="home-list" data-shape-items="li"><%= skeleton_items(shape('home-list', [4]).first, 'home-row', list: true) %><li class="sr-only"><%= t('home.loading') %></li></ul>
        <p class="home-foot" id="home-foot"></p>
      </div>
    </section>
<% end -%>
